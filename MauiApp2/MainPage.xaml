<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MauiApp2"
             x:DataType="viewmodel:MainViewModel"
             x:Class="MauiApp2.MainPage"
             Title="{Binding Title}">

    <VerticalStackLayout Spacing="10"
                         Margin="20">
        
        <StackLayout>
            <Image Source="pixel_controller.png"
               HeightRequest="200"
               Aspect="AspectFit"/>

            <Label Text="{Binding GreetingText}"
               FontSize="24"
               HorizontalTextAlignment="Center"/>

            <Label Text="{Binding GreetingSubText}"
               FontSize="18"
               TextColor="{StaticResource Tertiary}"
               HorizontalTextAlignment="Center"/>
        </StackLayout>

        <Button Text="Press here to change the greeting."
                Command="{Binding ChangeGreetingCommand}"/>

        <StackLayout Spacing="10">

            <Picker ItemsSource="{Binding AvailableOptions}"/>

            <Button Text="Go to Cool Pizza"
                Command="{Binding GoToDetailsCommand}"/>
        </StackLayout>

        <Grid ColumnDefinitions="*, 100">
            <Entry Placeholder="Enter a list item"
                   Text="{Binding UserInput, Mode=TwoWay}"/>
            <Button Text="Add"
                    Grid.Column="1"
                    Command="{Binding ChangeTitleCommand}"/>
        </Grid>
        
        
        <CollectionView ItemsSource="{Binding EntryItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:EntryItem">
                    <Grid ColumnDefinitions="50,*">
                        <Label Text="{Binding Name}"
                               FontSize="18"
                               Grid.Column="1"
                               VerticalTextAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsCompleted}"
                                  Grid.Column="0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>        
        
    </VerticalStackLayout>
    
    
    
